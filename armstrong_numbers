def armstrong(i):
    s = str(i)
    power = len(s)
    return i == sum(int(digit) ** power for digit in s)


def read_numbers(filename):
    numbers = []
    try:
        with open(filename, encoding='utf-8') as fin:
            for line in fin:
                number_str = line.strip()
                if number_str:
                    numbers.append(int(number_str))
        
        return numbers
        
    except OSError:
        print("There is a problem reading the file.")
        
        return numbers


def main():
    files_read = read_numbers('numbers.txt')              
    try:
        with open('armstrong.txt', 'w', encoding='utf-8') as fout:     
            for num in files_read:
                if armstrong(num):
                    fout.write(f"{num}\n")

    except OSError:
        print("There is a problem writing the file.")
        exit(2)


if __name__ == '__main__':
    main()
